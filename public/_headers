# Cloudflare Pages headers
# _headers file is copied to dist/ on build (Vite serves public/* at root)
/db/*.geojson
  Cache-Control: public, max-age=3600
/db/*.json
  Cache-Control: public, max-age=3600
/db/*.csv
  Cache-Control: public, max-age=3600
/assets/*
  Cache-Control: public, max-age=31536000, immutable
