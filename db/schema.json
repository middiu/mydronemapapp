{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MyDroneMap Rules Database Schema",
  "description": "Schema for the local drone airspace database. CASA baseline, NSW state (NPWS permit policy), and controlled airports (5.5km CASA exclusion). Each controlled airport entry must include name, lat, lon, exclusion_km, and rule text.",
  "type": "object",
  "required": ["metadata", "casa_baseline"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["version", "last_updated", "scope"],
      "properties": {
        "version": { "type": "string" },
        "last_updated": { "type": "string", "format": "date" },
        "scope": { "type": "string" },
        "data_sources": { "type": "object" },
        "notes": { "type": "string" }
      }
    },
    "casa_baseline": {
      "type": "object",
      "required": ["rules", "weight_rules", "airport_rule"],
      "properties": {
        "rules": { "type": "array", "items": { "type": "string" } },
        "weight_rules": { "type": "object" },
        "airport_rule": { "type": "string" }
      }
    },
    "nsw_state": {
      "type": "object",
      "properties": {
        "scope": { "type": "string" },
        "status": { "type": "string" },
        "summary": { "type": "string" },
        "exclusion_examples": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" },
        "policy_date": { "type": "string" }
      }
    },
    "controlled_airports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "lat", "lon", "exclusion_km", "rule"],
        "properties": {
          "name": { "type": "string" },
          "icao": { "type": "string" },
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "exclusion_km": { "type": "number" },
          "rule": { "type": "string" }
        }
      }
    }
  }
}