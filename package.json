{
  "name": "mydronemap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local browser map for recreational drone airspace over Greater Sydney. CASA Part 101 baselines, NPWS state rules, controlled airports, protected areas, smaller aerodromes. Works offline.",
  "scripts": {
    "dev": "vite",
